# ─── Return-It Environment Variables ─────────────────────────────────────────
#
# Copy this file to .env.local and fill in your values.
# All services fall back to demo/console-log mode when keys are missing.
#
# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
# Domain verification required for custom FROM address.
RESEND_API_KEY=
EMAIL_FROM="Return-It <hello@return-it.co.uk>"

# ─── Analytics (PostHog) ─────────────────────────────────────────────────────
# Get your project API key from: https://posthog.com → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Data Storage (Airtable) ────────────────────────────────────────────────
# Get from: https://airtable.com/account → API section
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Pickup Requests

# ─── File Upload (Cloudinary) ───────────────────────────────────────────────
# Get from: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
