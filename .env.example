# ─── Return-It Environment Variables ─────────────────────────────────────────
#
# Copy this file to .env.local and fill in your values.
# All services fall back to demo/console-log mode when keys are missing.
#
# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
# Domain verification required for custom FROM address.
RESEND_API_KEY=
EMAIL_FROM="Return-It <hello@return-it.co.uk>"

# ─── Analytics (PostHog) ─────────────────────────────────────────────────────
# Get your project API key from: https://posthog.com → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Data Storage (Airtable) ────────────────────────────────────────────────
# Get from: https://airtable.com/account → API section
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Pickup Requests

# ─── File Upload (Cloudinary) ───────────────────────────────────────────────
# Get from: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Database (Supabase) ────────────────────────────────────────────────────
# Project: return-it (eu-west-2 / London, for UK data residency)
# Dashboard: https://supabase.com/dashboard/project/ltzyybpbigibirpcjhwp
NEXT_PUBLIC_SUPABASE_URL=https://ltzyybpbigibirpcjhwp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the client — it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Inbound Email (forward ingestion) ──────────────────────────────────────
# Per-user addresses are issued at this domain, e.g. lola-4f2a@in.return-it.co.uk
INGEST_DOMAIN=in.return-it.co.uk
# HMAC-SHA256 secret for the inbound webhook. Verification FAILS CLOSED when
# unset — an unset secret must never mean "accept everything".
INBOUND_WEBHOOK_SECRET=
